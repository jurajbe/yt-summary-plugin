{
  "manifest_version": 3,
  "name": "Skip the Video — YouTube summaries by Claude",
  "short_name": "Skip the Video",
  "version": "1.0.0",
  "description": "Get the point of any YouTube video in seconds: TL;DR, key points or a deep dive, with clickable timestamps and follow-up questions.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Skip the Video — settings",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": ["storage"],
  "host_permissions": ["https://api.anthropic.com/*"],
  "commands": {
    "summarize": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Get the point of the current video"
    }
  }
}
